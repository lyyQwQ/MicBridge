# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# .NET build artifacts
**/bin/
**/obj/
/.bak/

# Build output and local tooling state at any depth
build/
.bak/
.vs/
*.user
.flutter-plugins*
/android/.gradle/
/android/.kotlin/
/android/local.properties
/android/key.properties
*.jks
*.keystore
*.apk
*.aab
*.exe
*.dll
*.pdb
*.so
*.dylib

# Screenshots; preserve platform application icon resources
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.webp
*.gif
*.bmp
*.ico
!/android/app/src/main/res/**
!/windows/runner/resources/**
!/web/icons/**
!/docs/images/desktop.png
!/docs/images/android.png

# Local diagnostic captures and accidentally local temporary directories
/.tmp-*
/%TEMP%/
/%TMP%/

# Trellis session caches (retain task specifications and journal Markdown)
/.trellis/.runtime/
/.trellis/workspace/**/trace*.jsonl
/.trellis/workspace/**/session*.jsonl
/.trellis/workspace/**/*.lock

# Local configuration and caches
local.properties
key.properties
.gradle/
.kotlin/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.cache/
